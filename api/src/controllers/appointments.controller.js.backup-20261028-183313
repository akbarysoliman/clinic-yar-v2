/* لیست درخواست‌های نوبت (pending) — برای منشی/مدیر              */
/* ============================================================ */
export async function listPendingAppointments(req, res) {
  const clinicId = req.user?.clinic_id;
  if (!clinicId) {
    return res.status(403).json({ error: "حساب کاربری به کلینیک متصل نیست" });
  }

  try {
    const { rows } = await query(
      `SELECT 
         a.id,
         a.appointment_at,
         a.status,
         a.notes,
         a.created_at,
         a.booked_by_patient,
         p.id AS patient_id,
         p.full_name AS patient_name,
         p.phone AS patient_phone,
         p.national_code AS patient_national_code,
         d.id AS doctor_id,
         u.full_name AS doctor_name,
         s.name AS doctor_specialty,
         b.id AS branch_id,
         b.name AS branch_name,
         c.id AS clinic_id,
         c.name AS clinic_name
       FROM appointments a
       JOIN patients p ON p.id = a.patient_id
       JOIN doctors d ON d.id = a.doctor_id
       JOIN users u ON u.id = d.user_id
       LEFT JOIN specialties s ON s.id = d.specialty_id
       JOIN branches b ON b.id = a.branch_id
       JOIN clinics c ON c.id = b.clinic_id
       WHERE c.id = $1
         AND a.status = 'pending'
         AND a.booked_by_patient IS NOT NULL
       ORDER BY a.created_at DESC`,
      [clinicId]
    );

    res.json({ pending: rows });
  } catch (err) {
    console.error("listPendingAppointments error:", err);
    res.status(500).json({ error: "خطا در دریافت درخواست‌ها" });
  }
}

/* ============================================================ */
/* تأیید یا رد درخواست نوبت — برای منشی/مدیر                     */
/* ============================================================ */
export async function reviewAppointment(req, res) {
  const clinicId = req.user?.clinic_id;
  const { id } = req.params;
  const { action } = req.body; // "approve" | "reject"

  if (!clinicId) {
    return res.status(403).json({ error: "حساب کاربری به کلینیک متصل نیست" });
  }

  if (!["approve", "reject"].includes(action)) {
    return res.status(400).json({ error: "عملیات نامعتبر است" });
  }

  try {
    // بررسی وجود نوبت در همین کلینیک
    const check = await query(
  `SELECT 
     a.id, a.status, a.doctor_id, a.appointment_at,
     a.patient_id, a.booked_by_patient,
     p.full_name AS patient_name,
     u.full_name AS doctor_name,
     b.name AS branch_name
   FROM appointments a
   JOIN branches b ON b.id = a.branch_id
   JOIN patients p ON p.id = a.patient_id
   JOIN doctors d ON d.id = a.doctor_id
   JOIN users u ON u.id = d.user_id
   WHERE a.id = $1 AND b.clinic_id = $2`,
  [id, clinicId]
);

    if (check.rows.length === 0) {
      return res.status(404).json({ error: "درخواست یافت نشد" });
    }

    const appointment = check.rows[0];

    if (appointment.status !== "pending") {
      return res.status(409).json({
        error: "این درخواست قبلاً بررسی شده است",
        code: "ALREADY_REVIEWED",
      });
    }

    if (action === "approve") {
      // بررسی اینکه اسلات هنوز خالی است
      const conflict = await query(
        `SELECT id FROM appointments
         WHERE doctor_id = $1 AND appointment_at = $2
           AND status IN ('booked', 'checked_in', 'in_visit')
           AND id <> $3`,
        [appointment.doctor_id, appointment.appointment_at, id]
      );

      if (conflict.rows.length > 0) {
        return res.status(409).json({
          error: "این زمان قبلاً توسط نوبت دیگری گرفته شده است",
          code: "SLOT_TAKEN",
        });
      }

      // تأیید: status → booked
             // تأیید: status → booked
        const { rows } = await query(
          `UPDATE appointments
           SET status = 'booked'
           WHERE id = $1
           RETURNING id, status, appointment_at`,
          [id]
        );

        // ساخت اعلان برای بیمار (اگه درخواست از پنل بیمار بوده)
        if (appointment.booked_by_patient) {
          const appointmentDate = new Date(appointment.appointment_at).toLocaleString("fa-IR", {
            year: "numeric",
            month: "long",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
          });

          await createNotification({
            patientAccountId: appointment.booked_by_patient,
            clinicId,
            type: "appointment_confirmed",
            title: "نوبت شما تأیید شد",
            message: `نوبت شما با دکتر ${appointment.doctor_name} در ${appointment.branch_name} برای ${appointmentDate} تأیید شد.`,
            link: "/patient/appointments",
            metadata: {
              appointment_id: id,
              doctor_id: appointment.doctor_id,
            },
          });
        }

        return res.json({
          appointment: rows[0],
          message: "درخواست نوبت تأیید شد",
        });
    }

    // رد: status → rejected
         // رد: status → rejected
      const { rows } = await query(
        `UPDATE appointments
         SET status = 'rejected'
         WHERE id = $1
         RETURNING id, status, appointment_at`,
        [id]
      );

      // ساخت اعلان برای بیمار (اگه درخواست از پنل بیمار بوده)
      if (appointment.booked_by_patient) {
        const appointmentDate = new Date(appointment.appointment_at).toLocaleString("fa-IR", {
          year: "numeric",
          month: "long",
          day: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        });

        await createNotification({
          patientAccountId: appointment.booked_by_patient,
          clinicId,
          type: "appointment_rejected",
          title: "درخواست نوبت شما رد شد",
          message: `متأسفانه درخواست نوبت شما با دکتر ${appointment.doctor_name} در ${appointment.branch_name} برای ${appointmentDate} رد شد.`,
          link: "/patient/new-appointment",
          metadata: {
            appointment_id: id,
            doctor_id: appointment.doctor_id,
          },
        });
      }

      res.json({
        appointment: rows[0],
        message: "درخواست نوبت رد شد",
      });
  } catch (err) {
    console.error("reviewAppointment error:", err);
    res.status(500).json({ error: "خطا در بررسی درخواست" });
  }
}

